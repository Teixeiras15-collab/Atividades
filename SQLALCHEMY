      "source": [
        "from sqlalchemy import insert\n",
        "from datetime import date\n",
        "\n",
        "# Lista de dicionários contendo múltiplos projetos\n",
        "lista_de_projetos = [\n",
        "    {\n",
        "        'nome_projeto': 'Desenvolvimento App RH',\n",
        "        'data_inicio': date(2023, 1, 15),\n",
        "        'data_fim': date(2023, 6, 30)\n",
        "    },\n",
        "    {\n",
        "        'nome_projeto': 'Migração de Dados Legados',\n",
        "        'data_inicio': date(2023, 3, 1),\n",
        "        'data_fim': date(2023, 9, 30)\n",
        "    },\n",
        "    {\n",
        "        'nome_projeto': 'Otimização de Processos Internos',\n",
        "        'data_inicio': date(2023, 7, 1),\n",
        "        'data_fim': date(2023, 12, 15)\n",
        "    }\n",
        "]\n",
        "\n",
        "# Passo 2: Faça uma inserção em lote (bulk insert)\n",
        "with engine.begin() as conn:\n",
        "    conn.execute(insert(projetos), lista_de_projetos)\n",
        "\n",
        "print(f\"{len(lista_de_projetos)} projetos inseridos com sucesso na tabela 'projetos'.\")\n",
        "\n",
        "# Validar a inserção consultando os dados\n",
        "df_projetos = pd.read_sql_query(text(\"SELECT * FROM projetos\"), con=engine)\n",
        "display(df_projetos)"
