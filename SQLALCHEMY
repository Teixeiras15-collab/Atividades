      "source": [
        "from sqlalchemy import update\n",
        "\n",
        "# Ensure 'metadata' object knows about 'funcionarios' table\n",
        "# This is necessary because 'funcionarios' was created via raw SQL earlier,\n",
        "# and not programmatically defined using the current 'metadata' object.\n",
        "metadata.reflect(bind=engine)\n",
        "\n",
        "# Exibir a tabela antes do reajuste para comparação\n",
        "print(\"Tabela 'funcionarios' antes do reajuste:\")\n",
        "df_funcionarios_antes = pd.read_sql_query(text(\"SELECT * FROM funcionarios\"), con=engine)\n",
        "display(df_funcionarios_antes)\n",
        "\n",
        "# Passo 3: Aumentar o salário apenas dos funcionários que ocupam o cargo de 'Desenvolvedor Júnior'\n",
        "with engine.begin() as conn:\n",
        "    stmt = (update(metadata.tables['funcionarios']).\n",
        "           where(metadata.tables['funcionarios'].c.cargo == 'Desenvolvedor Júnior').\n",
        "           values(salario=metadata.tables['funcionarios'].c.salario * 1.10)) # Aumento de 10%\n",
        "    conn.execute(stmt)\n",
        "\n",
        "print(\"Salários dos 'Desenvolvedor Júnior' reajustados com sucesso (10% de aumento).\")\n",
        "\n",
        "# Validar o reajuste consultando os dados novamente\n",
        "print(\"Tabela 'funcionarios' depois do reajuste:\")\n",
        "df_funcionarios_depois = pd.read_sql_query(text(\"SELECT * FROM funcionarios\"), con=engine)\n",
        "display(df_funcionarios_depois)"
