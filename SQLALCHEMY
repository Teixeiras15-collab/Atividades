        "}\n",
        "\n",
        "# Passo 3: Utilize o comando INSERT passando parâmetros seguros\n",
        "with engine.begin() as conn:\n",
        "    conn.execute(text(\"INSERT INTO funcionarios (nome, cargo, salario) VALUES (:nome, :cargo, :salario)\"),\n",
        "                 novo_funcionario)\n",
        "\n",
        "print(\"Novo funcionário inserido com segurança.\")"
      ],
