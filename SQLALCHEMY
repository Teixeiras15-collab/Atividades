      "source": [
        "import pandas as pd\n",
        "\n",
        "# Simular dados de um formulário web\n",
        "novo_funcionario = {\n",
        "    'nome': 'João Silva',\n",
        "    'cargo': 'Desenvolvedor Júnior',\n",
