        "id": "f41a1a61",
        "outputId": "bda776d6-219f-430c-8761-89f64360514d"
      },
      "source": [
        "from sqlalchemy import Table, MetaData, Column, Integer, String, Date\n",
        "\n",
        "# Defina um objeto MetaData\n",
        "metadata = MetaData()\n",
        "\n",
        "# Passo 1: Defina uma nova tabela chamada projetos de forma programática\n",
        "projetos = Table(\n",
        "    'projetos',\n",
        "    metadata,\n",
        "    Column('id', Integer, primary_key=True, autoincrement=True),\n",
        "    Column('nome_projeto', String(100), nullable=False),\n",
        "    Column('data_inicio', Date),\n",
        "    Column('data_fim', Date)\n",
        ")\n",
        "\n",
        "# Crie a tabela fisicamente no banco com metadata.create_all(engine)\n",
        "metadata.create_all(engine)\n",
        "\n",
        "print(\"Tabela 'projetos' definida e criada com sucesso.\")"
      ],
      "execution_count": 6,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Tabela 'projetos' definida e criada com sucesso.\n"
          ]
        }
